                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush" Storyboard.TargetProperty="Color" To="#FF252525" Duration="0:0:0.10" />
                                            <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#FFBDBDBD" Duration="0:0:0.10" />
