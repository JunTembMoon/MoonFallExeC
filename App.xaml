                                            <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#FFFFFFFF" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
