                                            <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#FFFFFFFF" Duration="0:0:0.05" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
