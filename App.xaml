                                            <ColorAnimation Storyboard.TargetName="FgBrush" Storyboard.TargetProperty="Color" To="#FF555555" Duration="0:0:0.10" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
