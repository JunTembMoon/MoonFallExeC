<UserControl x:Class="Potassium_UI_V2.Views.ScriptHub.ScriptHub" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Potassium_UI_V2.Views.ScriptHub" xmlns:ws="https://schemas.elecho.dev/wpfsuite" xmlns:sys="clr-namespace:System;assembly=netstandard" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid>
        <DockPanel Margin="7,50" VerticalAlignment="Top" LastChildFill="True">
            <Border Name="SearchBoxBorder" CornerRadius="6" Cursor="No" Background="{DynamicResource Theme_SearchBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="34" Margin="0,0,0,0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" RenderingBias="Quality" Direction="0" BlurRadius="20" Color="Black" Opacity="0.2" />
                </Border.Effect>
                <Grid Name="SearchBoxGrid" Width="Auto" Height="34" VerticalAlignment="Top">
                    <Viewbox Width="14" Height="14" HorizontalAlignment="Left" Margin="8,0,0,0">
                        <iconPacks:PackIconFontAwesome Kind="MagnifyingGlassSolid" Foreground="{DynamicResource Theme_SearchIcon}" />
                    </Viewbox>
                    <TextBox Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Theme_SearchText}" CaretBrush="White" Margin="30,0,8,0" VerticalContentAlignment="Center" FontSize="13" FontFamily="{StaticResource WorkSans}" Padding="0,1,0,0" Cursor="IBeam" TextChanged="njwCVp8Zs" />
                </Grid>
            </Border>
        </DockPanel>
        <ScrollViewer Name="ScrollViewerMain" VerticalScrollBarVisibility="Auto" Margin="2,90,0,0" ScrollChanged="cZ4X5VD22">
            <ScrollViewer.Resources>
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">10</sys:Double>
                <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernScrollBar}" />
            </ScrollViewer.Resources>
            <ItemsControl Name="ScriptItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Border CornerRadius="6" Background="{DynamicResource Theme_CardBackground}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="25" Color="Black" Opacity="0.3" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="6" BorderBrush="{DynamicResource Theme_CardBorder}" BorderThickness="1.5" Background="{DynamicResource Theme_CardBackground}" Padding="10">
                                <StackPanel>
                                    <Border CornerRadius="4" Height="120" Margin="0,0,0,10" ClipToBounds="True">
                                        <Image Stretch="UniformToFill" VerticalAlignment="Center" Source="{Binding ImageUrl , IsAsync=True}" />
                                    </Border>
                                    <TextBlock FontSize="14" Foreground="{DynamicResource Theme_PrimaryText}" FontFamily="{StaticResource WorkSans}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Theme_AuthorText}" FontFamily="{StaticResource WorkSans}" Margin="0,2,0,0" Text="{Binding Author}" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{DynamicResource ButtonStyle}" FontSize="13" Height="27" Grid.Column="0">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="Execute" FontSize="13" FontFamily="{StaticResource WorkSans}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                        <Button Style="{DynamicResource ButtonStyle}" Width="27" Height="27" Grid.Column="1" Margin="5,0,0,0">
                                            <Button.ContentTemplate>
                                                <DataTemplate>
                                                    <iconPacks:PackIconFontAwesome Kind="ArrowUpRightFromSquareSolid" Foreground="{DynamicResource Theme_SecondaryText}" Width="11" Height="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </Button.ContentTemplate>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>